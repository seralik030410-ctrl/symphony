SYMPHONY_HOST=127.0.0.1
SYMPHONY_PORT=8765
SYMPHONY_DATABASE_PATH=data/symphony.db
SYMPHONY_WORKSPACE_ROOT=data/workspaces
SYMPHONY_SKILLS_ROOT=data/skills
SYMPHONY_SEED_BUNDLED_SKILLS=true
SYMPHONY_MAX_TOOL_CALLS=12
SYMPHONY_TOOL_TIMEOUT_SECONDS=10
SYMPHONY_SANDBOX_IMAGE=symphony-sandbox:stage3
SYMPHONY_SANDBOX_MEMORY=768m
SYMPHONY_SANDBOX_CPUS=1.5
SYMPHONY_SANDBOX_PIDS_LIMIT=256
SYMPHONY_SANDBOX_OUTPUT_LIMIT=100000
SYMPHONY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Ollama profile
SYMPHONY_OLLAMA_BASE_URL=http://127.0.0.1:11434
SYMPHONY_OLLAMA_MODEL=qwen3.5:9b

# OpenAI-compatible profile (LM Studio, vLLM, llama.cpp server, etc.)
